@using Sample.AspNetCore.Webpay
@using Webpay.Integration.Util.Constant
@{
    ViewData["Title"] = "Checkout";
    var isCompany = TempData["IsCompany"] != null && Convert.ToBoolean(TempData["IsCompany"]);

    var country = TempData["CountryId"] != null ? TempData["CountryId"].ToString() : "SE";
    var testCustomers = new List<dynamic>();

    if(country == "NO")
    {
        testCustomers = new List<dynamic>
        {
            new { Result = "Approved", PersonOrOrgNr = "17054512066", CustomerType = "Private", Description = "Credit check successful." },
            new { Result = "Denied", PersonOrOrgNr = "14077421433", CustomerType = "Private", Description = "Credit not approved; order can still be placed." },
            new { Result = "Abuse", PersonOrOrgNr = "30036549854", CustomerType = "Private", Description = "Flagged for potential fraud." },
            new { Result = "Limit", PersonOrOrgNr = "22084419684", CustomerType = "Private", Description = "Credit limit reached." },
            new { Result = "Approved", PersonOrOrgNr = "923313850", CustomerType = "Company", Description = "Credit check successful." },
            new { Result = "Denied", PersonOrOrgNr = "842852102", CustomerType = "Company", Description = "Credit not approved; order can still be placed." },
            new { Result = "Abuse", PersonOrOrgNr = "931024280", CustomerType = "Company", Description = "Flagged for potential fraud." },
            new { Result = "Limit", PersonOrOrgNr = "812345672", CustomerType = "Company", Description = "Credit limit reached." }
        };
    }
    else if(country == "FI")
    {
        testCustomers = new List<dynamic>
        {
            new { Result = "Approved", PersonOrOrgNr = "160264-999N", CustomerType = "Private", Description = "Credit check successful." },
            new { Result = "Denied", PersonOrOrgNr = "111248-999C", CustomerType = "Private", Description = "Credit not approved; order can still be placed." },
            new { Result = "Abuse", PersonOrOrgNr = "261295-9985", CustomerType = "Private", Description = "Flagged for potential fraud." },
            new { Result = "Limit", PersonOrOrgNr = "261295-9985", CustomerType = "Private", Description = "Credit limit reached." },
            new { Result = "Approved", PersonOrOrgNr = "9999999-2", CustomerType = "Company", Description = "Credit check successful." },
            new { Result = "Denied", PersonOrOrgNr = "8888888-3", CustomerType = "Company", Description = "Credit not approved; order can still be placed." },
            new { Result = "Abuse", PersonOrOrgNr = "7777777-4", CustomerType = "Company", Description = "Flagged for potential fraud." },
            new { Result = "Limit", PersonOrOrgNr = "6666666-5", CustomerType = "Company", Description = "Credit limit reached." }
        };
    }
    else
    {
        testCustomers = new List<dynamic>
        {
            new { Result = "Approved", PersonOrOrgNr = "4605092222", CustomerType = "Private", Description = "Credit check successful." },
            new { Result = "Denied", PersonOrOrgNr = "4610081111", CustomerType = "Private", Description = "Credit not approved; order can still be placed." },
            new { Result = "Abuse", PersonOrOrgNr = "4606082222", CustomerType = "Private", Description = "Flagged for potential fraud." },
            new { Result = "Limit", PersonOrOrgNr = "4611071111", CustomerType = "Private", Description = "Credit limit reached." },
            new { Result = "Approved", PersonOrOrgNr = "4608142222", CustomerType = "Company", Description = "Credit check successful." },
            new { Result = "Denied", PersonOrOrgNr = "4608302222", CustomerType = "Company", Description = "Credit not approved; order can still be placed." },
            new { Result = "Abuse", PersonOrOrgNr = "4609191111", CustomerType = "Company", Description = "Flagged for potential fraud." },
            new { Result = "Limit", PersonOrOrgNr = "4506172222", CustomerType = "Company", Description = "Credit limit reached." }
        };
    }

    var isVisible = TempData["IsTestCustomersVisible"] == null ? true : TempData["IsTestCustomersVisible"].ToString()?.ToLower() == "true";
    var useBankID = TempData["UseBankID"] != null ? Convert.ToBoolean(TempData["UseBankID"]) : false;
    var useKalp = TempData["UseKalp"] != null ? Convert.ToBoolean(TempData["UseKalp"]) : false;

    var config = new WebpayConfig();
    var countryCode = country.GetCountryCode();
    var wsEndPoint = config.GetEndPoint(PaymentType.INVOICE);
    var asEndPoint = config.GetEndPoint(PaymentType.ADMIN_TYPE);
    var webpayConfigVisible = false;

    var approvedPrivate = testCustomers.FirstOrDefault(x => x.Result == "Approved" && x.CustomerType == "Private");
    var approvedCompany = testCustomers.FirstOrDefault(x => x.Result == "Approved" && x.CustomerType == "Company");
    var privateSSN = approvedPrivate != null ? approvedPrivate.PersonOrOrgNr : "";
    var companySSN = approvedCompany != null ? approvedCompany.PersonOrOrgNr : "";
    var ssnPlaceholder = isCompany ? companySSN : privateSSN;
    
    var emailPlaceholder = "test@svea.com";
    var phonePlaceholder = "01111111";
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Svea Standalone Checkout</h1>

    <form id="toggleVisibilityForm" method="post" action="/CheckOut/UpdateTestCustomersVisibility">
        <input type="hidden" id="isTestCustomersVisible" name="IsTestCustomersVisibleInput" value="true" />
    </form>

    <button id="toggleTestCustomers" class="btn btn-sm btn-primary" style="position: absolute; top: 180px; right: 20px; z-index: 1001;">
        >
    </button>

    <div class="test-customers" id="testCustomers" style="position: absolute; top: 200px; right: 40px; width: 300px; z-index: 1000; display: @(isVisible ? "block" : "none");">
        <div class="card p-3" style="max-width: 100%;">
            <h5 class="text-center">Test Customers</h5>
            <ul class="list-group list-group-flush small">
                @foreach (var customer in testCustomers)
                {
                    <li class="list-group-item p-1">
                        <strong>@customer.Result</strong> -
                        @customer.PersonOrOrgNr -
                        @customer.CustomerType<br />
                        <span class="text-muted">@customer.Description</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <button id="toggleWebpayConfig" class="btn btn-sm btn-secondary mt-4">
        Webpay Config
    </button>

    <div id="webpayConfig" class="card mt-2" style="display:@(webpayConfigVisible ? "block" : "none");">
        <div class="card-header">
            Webpay Config Settings (Country: @country)
        </div>
        <div class="card-body">
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th colspan="5" class="text-center" style="padding-top:15px;">Credentials</th>
                    </tr>
                    <tr>
                        <th>Payment Type</th>
                        <th>Username</th>
                        <th>Password</th>
                        <th>Client Number</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Invoice</td>
                        <td>@config.GetUsername(PaymentType.INVOICE, countryCode)</td>
                        <td>@config.GetPassword(PaymentType.INVOICE, countryCode)</td>
                        <td>@config.GetClientNumber(PaymentType.INVOICE, countryCode)</td>
                    </tr>
                    <tr>
                        <td>PaymentPlan</td>
                        <td>@config.GetUsername(PaymentType.PAYMENTPLAN, countryCode)</td>
                        <td>@config.GetPassword(PaymentType.PAYMENTPLAN, countryCode)</td>
                        <td>@config.GetClientNumber(PaymentType.PAYMENTPLAN, countryCode)</td>
                    </tr>
                    @if (countryCode == CountryCode.SE)
                    {
                        <tr>
                            <td>AccountCredit</td>
                            <td>@config.GetUsername(PaymentType.ACCOUNTCREDIT, countryCode)</td>
                            <td>@config.GetPassword(PaymentType.ACCOUNTCREDIT, countryCode)</td>
                            <td>@config.GetClientNumber(PaymentType.ACCOUNTCREDIT, countryCode)</td>
                        </tr>
                    }
                </tbody>
                <thead>
                    <tr>
                        <th colspan="5" class="text-center" style="padding-top:15px;">Endpoints</th>
                    </tr>
                    <tr>
                        <th>Service</th>
                        <th colspan="4">URL</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>WebService</td>
                        <td colspan="4">@wsEndPoint</td>
                    </tr>
                    <tr>
                        <td>AdminService</td>
                        <td colspan="4">@asEndPoint</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="use-bankid-container" style="margin-top: 20px; margin-bottom: 20px;">
        <form id="toggleBankIDForm" method="post" action="/CheckOut/UpdateUseBankID">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="useBankID" name="useBankIDInput" value="true"
                       @(useBankID ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="useBankID">Use BankID</label>
            </div>
        </form>
    </div>

    <div class="use-kalp-container" style="margin-top: 20px; margin-bottom: 20px;">
        <form id="toggleKalpForm" method="post" action="/CheckOut/UpdateUseKalp">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="useKalp" name="useKalpInput" value="true"
                       @(useKalp ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="useKalp">Use Kalp</label>
            </div>
        </form>
    </div>

    <div class="card p-4 mb-4">
        <h4 class="card-title">Enter Your Details</h4>
        <form asp-action="SubmitForm" method="post">
            <div class="mb-3">
                <label for="ssn" class="form-label">SSN</label>
                <input type="text" id="ssn" name="SSN" class="form-control" placeholder="@ssnPlaceholder" data-private-placeholder="@privateSSN" data-company-placeholder="@companySSN" required />
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" id="isCompany" name="IsCompany" class="form-check-input" value="true" />
                <label for="isCompany" class="form-check-label">Is Company</label>
            </div>
            <div>
                <button type="submit" class="btn btn-primary">OK</button>
            </div>
        </form>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }

    @if (ViewBag.Addresses != null)
    {
        <div class="card p-4 mb-4">
            <h4 class="card-title">Customer Addresses</h4>
            <form asp-action="SaveSelectedAddress" method="post" id="addressSelectionForm">
                <ul class="list-group">
                    @for (var i = 0; i < ViewBag.Addresses.Length; i++)
                    {
                        var address = ViewBag.Addresses[i];
                        <li class="list-group-item">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="selectedAddressIndex"
                                       id="address-@i"
                                       value="@i"
                                @(i == 0 ? "checked" : "")
                                       onchange="document.getElementById('addressSelectionForm').submit()" />
                                <label class="form-check-label" for="address-@i">
                                    <strong>@address.SecurityNumber</strong><br />
                                    @address.FirstName @address.LastName<br />
                                    @address.AddressLine1 @address.AddressLine2<br />
                                    @address.Zipcode @address.Postarea<br />
                                    <span>Phone: @address.PhoneNumber</span><br />
                                    <span>AddressSelector: @address.AddressSelector</span>
                                </label>
                            </div>
                        </li>
                    }
                </ul>
            </form>
        </div>
    }

    @if (ViewBag.ShowAdditionalFields == true)
    {
        <div class="card p-4">
            <h4 class="card-title">Finalize Your Order</h4>
            <form asp-action="FinalizeForm" method="post">
                <div class="mb-3">
                    <label for="phoneNumber" class="form-label">Phone Number</label>
                    <input type="text" id="phoneNumber" name="PhoneNumber" class="form-control" placeholder="@phonePlaceholder" required />
                </div>

                <div class="mb-3">
                    <label for="emailAddress" class="form-label">Email Address</label>
                    <input type="email" id="emailAddress" name="EmailAddress" class="form-control" placeholder="@emailPlaceholder" required />
                </div>

                <div id="invoiceInfoNO" class="alert alert-info align-items-start gap-2 d-none" style="margin-top:12px;">
                    <div class="mt-3"><i class="fa fa-info-circle" aria-hidden="true"></i></div>
                    <div class="flex-grow-1">
                        <strong>Betal etter at du har mottatt dine varer.</strong>
                    </div>
                    <a href="#"
                       id="invoiceInfoNO_more"
                       class="ms-2 align-self-center"
                       aria-label="Mer informasjon"
                       title="Mer informasjon"
                       style="text-decoration:underline;"
                       data-bs-toggle="modal" data-bs-target="#invoiceInfoModalNO"
                       data-toggle="modal" data-target="#invoiceInfoModalNO">Mer info</a>
                </div>

                <div class="mb-3 mt-3">
                    <label for="paymentOption" class="form-label">Payment Option</label>
                    <select id="paymentOption" name="PaymentOption" class="form-select" onchange="handlePaymentOptionChange()">
                        <option value="Invoice">Invoice</option>
                        @if (!isCompany)
                        {
                            <option value="PaymentPlan">Payment Plan</option>
                            @if (countryCode == CountryCode.SE)
                            {
                                <option value="AccountCredit">Account Credit</option>
                            }
                        }
                    </select>
                </div>

                <div id="bankidDisclaimerNO" class="text-muted d-none" style="margin:10px 0 14px 0;">
                    Ved å identifisere deg med BankID i neste steg, godkjenner du vilkårene i
                    <a href="#" onclick="openCreditAgreementPdf(event)">kredittavtalen</a>.
                </div>

                <div id="campaignSection" class="mb-3" style="display: none;">
                    <h5>Available Campaigns</h5>
                    <div class="table-responsive" style="max-width: 100%;">
                        <table id="campaignTable"
                               class="table table-bordered table-sm"
                               style="width: 92%; margin: 0 auto; font-size: 0.95rem;">
                            <thead>
                                <tr id="paymentPlanHeader">
                                    <th>Campaign Code</th>
                                    <th>Description</th>
                                    <th>Contract Length (Months)</th>
                                    <th>Monthly Factor</th>
                                    <th>Initial Fee</th>
                                    <th>Notification Fee</th>
                                    <th>Interest Rate (%)</th>
                                    <th>Effective Interest (%)</th>
                                    <th>Interest-Free Months</th>
                                    <th>Payment-Free Months</th>
                                    <th>Amount Range</th>
                                    <th>Select</th>
                                </tr>
                                <tr id="accountCreditHeader" style="display: none;">
                                    <th>Campaign Code</th>
                                    <th>Description</th>
                                    <th>Initial Fee</th>
                                    <th>Lowest Amount to Pay Per Month</th>
                                    <th>Lowest Percent to Pay Per Month (%)</th>
                                    <th>Lowest Order Amount</th>
                                    <th>Interest Rate (%)</th>
                                    <th>Notification Fee</th>
                                    <th>Select</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Campaign Summary for selected campaign -->
                <div id="campaignSummary" class="card mb-3" style="display:none; max-width:500px; margin: 0 auto;">
                    <div class="card-body p-3">
                        <table class="table table-sm table-borderless mb-2">
                            <tbody>
                                <tr>
                                    <td>Uppläggningsavgift</td>
                                    <td class="text-end" id="summaryInitialFee"></td>
                                </tr>
                                <tr>
                                    <td>Administrationsavgift</td>
                                    <td class="text-end" id="summaryNotificationFee"></td>
                                </tr>
                                <tr>
                                    <td>Årsränta</td>
                                    <td class="text-end" id="summaryInterestRate"></td>
                                </tr>
                                <tr>
                                    <td>Effektiv ränta</td>
                                    <td class="text-end" id="summaryEffectiveInterest"></td>
                                </tr>
                                <tr>
                                    <td>Månad 1</td>
                                    <td class="text-end" id="summaryMonth1"></td>
                                </tr>
                                <tr id="summaryRestRow">
                                    <td>Månad 2–<span id="summaryMonthTo"></span></td>
                                    <td class="text-end" id="summaryMonthRest"></td>
                                </tr>
                                <tr>
                                    <td>Genomsnitt/mån</td>
                                    <td class="text-end" id="summaryAvgPerMonth"></td>
                                </tr>
                                <tr>
                                    <td><strong>Totalkostnad</strong></td>
                                    <td class="text-end" id="summaryTotalCost"><strong></strong></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-center">
                            <a href="#" id="saFunkarDetLink" data-bs-toggle="modal" data-bs-target="#saFunkarDetModal"
                               style="text-decoration:underline; font-weight:bold; color:#005aa0;">
                                Så funkar det
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Konsumentverket warning -->
                <div id="konsumentverketWarning" class="alert alert-warning mb-3" style="display:none; max-width: 720px; margin: 0 auto;">
                    <div style="font-size:1.5rem;">⚠️</div>
                    <div>
                        <strong>Att låna kostar pengar!</strong> Om du inte kan betala tillbaka skulden i tid
                        riskerar du en betalningsanmärkning. Det kan leda till svårigheter att få
                        hyra bostad, teckna abonnemang och få nya lån. För stöd, vänd dig till
                        budget- och skuldrådgivningen i din kommun. Kontaktuppgifter finns
                        på <a href="https://www.konsumentverket.se" target="_blank" rel="noopener noreferrer">konsumentverket.se</a>.
                    </div>
                </div>

                <!-- Purchase amount display -->
                <div id="purchaseAmountDisplay" class="text-center mb-3" style="display:none;">
                    <div style="font-size:2rem; font-weight:bold;" id="purchaseAmountValue"></div>
                    <div class="text-muted">Köpbelopp (inkl. moms)</div>
                </div>

                <!-- "Vad händer om jag inte följer betalplanen" section -->
                <div id="paymentPlanInfoSection" class="card mb-3" style="display:none; background-color:#f0f4f8;">
                    <div class="card-body">
                        <p>
                            <strong>Vad händer om jag inte följer betalplanen?</strong><br />
                            De här villkoren gäller så länge du följer betalplanen. Om du betalar ett lägre
                            belopp eller senare, börjar de
                            <a href="https://cdn.svea.com/webpay/sv-SE/WP_Allmanna%20villkor%20Delbetalning_Konto.pdf" target="_blank" rel="noopener noreferrer">generella villkoren</a>
                            att gälla, för närvarande 55 kr i
                            månaden i administrationsavgift och 22,00 % i rörlig årsränta.
                        </p>

                        <p>
                            <strong>Kostnadsexempel vid generella villkor</strong><br />
                            Om du handlar för 10 000 kr och betalar av det under 12 månader, innebär det
                            en månadskostnad på 991 kr (totalt 11 891 kr), och den effektiva räntan
                            blir 38,82 %.
                        </p>
                    </div>
                </div>

                <input type="hidden" id="selectedCampaignCode" name="CampaignCode" />
                <div>
                    <button type="submit" id="finalizeButton" class="btn btn-success">Finalize</button>
                    <button type="button" id="showCampaignsButton" class="btn btn-primary" style="display: none;" onclick="fetchCampaigns()">Show Campaigns</button>
                </div>

                <div class="mt-4 small text-muted" id="legalNotice">
                    @if (countryCode == CountryCode.NO)
                    {
                        var sveaTermsUrl = "https://cdn.svea.com/webpay/nn-NO/checkout-vilkaar.pdf";
                        <text>
                            Ved å bekrefte kjøpet, godkjenner jeg
                            <a href="@sveaTermsUrl" target="_blank" rel="noopener noreferrer">Sveas vilkår</a>,
                            <a href="@sveaTermsUrl" target="_blank" rel="noopener noreferrer">butikkens kjøpsvilkår</a>,
                            samt deling av mine opplysninger med butikken og den ansvarlige for leveranse av kjøpet.
                        </text>
                        <div class="mt-2">
                            <a href="https://www.svea.com/nb-no/om-oss/forbrukerrettigheter/" target="_blank" rel="noopener noreferrer">
                                Personvernerklæring og cookies
                            </a>
                        </div>
                    }
                    else
                    {
                        var sveaTermsUrl = "https://cdn.svea.com/webpay/sv-SE/SE_Checkout_villkor.pdf";
                        <text>
                            Genom att ange dina uppgifter godkänner du
                            <a href="@sveaTermsUrl" target="_blank" rel="noopener noreferrer">Sveas allmänna villkor</a>
                            och
                            <a href="@sveaTermsUrl" target="_blank" rel="noopener noreferrer">butikens köpvillkor</a>.
                            Du bekräftar också att du tagit del av
                            <a href="https://www.svea.com/sv-se/om-oss/integritet" target="_blank" rel="noopener noreferrer">Sveas dataskyddsinformation</a>.
                        </text>
                    }
                </div>

            </form>
        </div>
    }
</div>

<div class="modal fade" id="invoiceInfoModalNO" tabindex="-1" aria-labelledby="invoiceInfoModalNO_Label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="invoiceInfoModalNO_Label">Betaling med faktura</h5>
      </div>

      <div class="modal-body" style="white-space:pre-wrap;">
Betaling med faktura
Ved å velge faktura som betalingsmåte kan du betale etter at du har mottatt dine varer. Betaling med faktura krever at du er over 18 år. Det vil bli gjort en kredittvurdering av deg.

Når får jeg fakturaen?
Fakturaen sendes ut samtidig med varen og betalingsfrist er minimum 14 dager. Fakturaen sendes som eFaktura dersom du har godkjent dette, alternativt i DigiPost, per e-post eller per brev. Fakturaen vil også være tilgjengelig i Svea Pay app og på Mine Sider.

Er det noen ekstra kostnader?
Det er ingen kostnader knyttet til faktura så lenge du betaler i tide. 

Hva skjer hvis jeg ikke betaler?
Ved forsinket betaling vil det påløpe purregebyr og forsinkelsesrenter. Ved manglende betaling vil kravet bli overført til inkasso.
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">Lukk</button>
      </div>

    </div>
  </div>
</div>

<div class="modal fade" id="saFunkarDetModal" tabindex="-1" aria-labelledby="saFunkarDetModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content" style="background-color:#1a3a5c; color:#fff;">
      <div class="modal-body p-4">
        <h4 class="mb-3">Så funkar delbetalning</h4>

        <h6>Fast månadsbelopp</h6>
        <p>Du betalar ett fast månadsbelopp enligt den betalplan
        som du valt. Första månaden betalar du också en
        uppläggningsavgift.</p>

        <h6>Så mycket betalar du</h6>
        <table class="table table-sm table-borderless text-white mb-3">
            <tbody>
                <tr>
                    <td>● Idag</td>
                    <td class="text-end">0 kr</td>
                </tr>
                <tr>
                    <td class="ps-3">Månad 1</td>
                    <td class="text-end" id="modalMonth1"></td>
                </tr>
                <tr>
                    <td class="ps-3">Månad 2</td>
                    <td class="text-end" id="modalMonth2"></td>
                </tr>
                <tr>
                    <td class="ps-3" id="modalMonthRangeLabel">Månad 3–</td>
                    <td class="text-end" id="modalMonthRest"></td>
                </tr>
            </tbody>
        </table>

        <p class="small">I månadsbeloppet ingår avbetalning på ditt köp,
        administrationsavgift och eventuell ränta.</p>

        <h6>Har du frågor?</h6>
        <p>Kontakta kundtjänst på 08-514 931 13 så hjälper vi dig.</p>
      </div>
      <div class="modal-footer border-0 p-3">
        <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">Stäng</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>

        // Norway-specific payment terms info
        const IS_NO_COUNTRY = @((countryCode == CountryCode.NO).ToString().ToLower());

        function setNOInvoiceVisibility(show) {
          const info = document.getElementById("invoiceInfoNO");
          const bankid = document.getElementById("bankidDisclaimerNO");
          if (info) {
            info.classList.toggle('d-none', !show);
            info.classList.toggle('d-flex', show);
          }
          if (bankid) bankid.classList.toggle('d-none', !show);
        }

        document.addEventListener("DOMContentLoaded", function () {
          const sel = document.getElementById("paymentOption");
          if (sel) sel.addEventListener("change", handlePaymentOptionChange);

          handlePaymentOptionChange();
        });

        // Payment option change
        function handlePaymentOptionChange() {
            const paymentOption = document.getElementById("paymentOption").value;
            const finalizeButton = document.getElementById("finalizeButton");
            const showCampaignsButton = document.getElementById("showCampaignsButton");
            const campaignSection = document.getElementById("campaignSection");
            const paymentPlanHeader = document.getElementById("paymentPlanHeader");
            const accountCreditHeader = document.getElementById("accountCreditHeader");

            paymentPlanHeader.style.display = "none";
            accountCreditHeader.style.display = "none";

            // Hide payment plan specific sections (enabled via updateCampaignSummary)
            document.getElementById("campaignSummary").style.display = "none";
            document.getElementById("konsumentverketWarning").style.setProperty('display', 'none', 'important');
            document.getElementById("paymentPlanInfoSection").style.display = "none";
            document.getElementById("purchaseAmountDisplay").style.display = "none";

            if (paymentOption === "PaymentPlan") {
                paymentPlanHeader.style.display = "";
                finalizeButton.style.display = "none";
                showCampaignsButton.style.display = "block";
                campaignSection.style.display = "none";
            } else if (paymentOption === "AccountCredit") {
                accountCreditHeader.style.display = "";
                finalizeButton.style.display = "none";
                showCampaignsButton.style.display = "block";
                campaignSection.style.display = "none";
            } else {
                finalizeButton.style.display = "block";
                showCampaignsButton.style.display = "none";
                campaignSection.style.display = "none";
            }

            const showNOInvoice = IS_NO_COUNTRY && paymentOption === "Invoice";
            setNOInvoiceVisibility(showNOInvoice);
        }

        function openInvoiceInfoModalNO() {
          const el = document.getElementById('invoiceInfoModalNO');
          if (!el) return;

          // Bootstrap v5.x:
          if (window.bootstrap && bootstrap.Modal) {
            // getOrCreateInstance if available (bootstrap 5.2+), else use via constructor
            const modal = (typeof bootstrap.Modal.getOrCreateInstance === 'function')
              ? bootstrap.Modal.getOrCreateInstance(el)
              : (bootstrap.Modal.getInstance?.(el) || new bootstrap.Modal(el));

            modal.show();
            return;
          }

          // Bootstrap v4 fallback (jQuery plugin)
          if (window.jQuery && typeof jQuery.fn.modal === 'function') {
            jQuery('#invoiceInfoModalNO').modal('show');
            return;
          }

          // fallback
          alert('Betaling med faktura...\n\n(Modal requires Bootstrap JS to be loaded)');
        }

        document.addEventListener('DOMContentLoaded', function () {
          const isBS5 = !!(window.bootstrap && bootstrap.Modal);
          const btnClose5 = document.querySelector('#invoiceInfoModalNO .btn-close');
          const btnClose4 = document.querySelector('#invoiceInfoModalNO .close');
          if (isBS5) {
            btnClose4?.classList.add('d-none');
            btnClose5?.classList.remove('d-none');
          } else if (window.jQuery && typeof jQuery.fn.modal === 'function') {
            btnClose5?.classList.add('d-none');
            btnClose4?.classList.remove('d-none');
          }
        });

        // Open norweigan credit agreement PDF in new tab
        async function openCreditAgreementPdf(e) {
            e.preventDefault();
            try {
                const url = '/CheckOut/GetInvoiceCreditAgreementPdf?paymentOption=Invoice&country=NO';
                const resp = await fetch(url);
                if (!resp.ok) throw new Error('Klarte ikke å hente kredittavtalen.');
                const buf = await resp.arrayBuffer();
                const blob = new Blob([buf], { type: 'application/pdf' });
                const blobUrl = URL.createObjectURL(blob);
                window.open(blobUrl, '_blank');
                // Revoke after some delay
                setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
            } catch (err) {
                alert(err.message || 'Noe gikk galt ved åpning av kredittavtalen.');
            }
        }

        // Store campaigns globally for summary calculations
        let currentCampaigns = [];
        let cartTotal = 0;

        // Campaign helpers
        async function fetchCartTotal() {
            try {
                const resp = await fetch('/CheckOut/GetCartTotal');
                const data = await resp.json();
                cartTotal = data.total;
            } catch (e) {
                console.error('Failed to fetch cart total', e);
            }
        }

        async function fetchCampaigns() {
            const paymentOption = document.getElementById("paymentOption").value;
            const showCampaignsButton = document.getElementById("showCampaignsButton");

            await fetchCartTotal();

            try {
                const response = await fetch(`/CheckOut/GetCampaigns?paymentOption=${paymentOption}`);
                if (!response.ok) throw new Error("Failed to fetch campaigns.");

                const campaigns = await response.json();
                currentCampaigns = campaigns;
                const campaignTableBody = document.querySelector("#campaignTable tbody");
                const hiddenSelectedCampaignCode = document.getElementById("selectedCampaignCode");
                campaignTableBody.innerHTML = "";

                campaigns.forEach((campaign, index) => {
                    let row;
                    if (paymentOption === "AccountCredit") {
                        row = `
                            <tr>
                                <td>${campaign.campaignCode}</td>
                                <td>${campaign.description}</td>
                                <td>${campaign.initialFee}</td>
                                <td>${campaign.lowestAmountToPayPerMonth}</td>
                                <td>${campaign.lowestPercentToPayPerMonth}%</td>
                                <td>${campaign.lowestOrderAmount}</td>
                                <td>${campaign.interestRatePercent}%</td>
                                <td>${campaign.notificationFee}</td>
                                <td>
                                    <input type="radio" name="CampaignCode" value="${campaign.campaignCode}" ${index === 0 ? "checked" : ""} />
                                </td>
                            </tr>
                        `;
                    } else {
                        row = `
                            <tr>
                                <td>${campaign.campaignCode}</td>
                                <td>${campaign.description}</td>
                                <td>${campaign.contractLengthInMonths}</td>
                                <td>${formatDecimal(campaign.monthlyAnnuityFactor)}</td>
                                <td>${campaign.initialFee}</td>
                                <td>${campaign.notificationFee}</td>
                                <td>${campaign.interestRatePercent}%</td>
                                <td>${formatDecimal(campaign.effectiveInterest)}%</td>
                                <td>${campaign.numberOfInterestFreeMonths}</td>
                                <td>${campaign.numberOfPaymentFreeMonths}</td>
                                <td>${campaign.fromAmount} - ${campaign.toAmount}</td>
                                <td>
                                    <input type="radio" name="CampaignCode" value="${campaign.campaignCode}" ${index === 0 ? "checked" : ""} />
                                </td>
                            </tr>
                        `;
                    }
                    campaignTableBody.insertAdjacentHTML("beforeend", row);
                });

                hiddenSelectedCampaignCode.value = campaigns[0].campaignCode;

                document.getElementById("campaignSection").style.display = "block";
                document.getElementById("finalizeButton").style.display = "block";
                showCampaignsButton.style.display = "none";

                // Show extra sections for PaymentPlan
                if (paymentOption === "PaymentPlan") {
                    document.getElementById("konsumentverketWarning").style.display = "flex";
                    document.getElementById("konsumentverketWarning").style.setProperty('display', 'flex', 'important');
                    document.getElementById("paymentPlanInfoSection").style.display = "block";
                    document.getElementById("purchaseAmountDisplay").style.display = "block";
                    document.getElementById("purchaseAmountValue").textContent =
                        cartTotal.toLocaleString('sv-SE') + " kr";
                    updateCampaignSummary(campaigns[0]);
                }

                document.addEventListener("change", (event) => {
                    if (event.target.name === "CampaignCode") {
                        const selectedCode = event.target.value;
                        document.getElementById("selectedCampaignCode").value = selectedCode;
                        const selected = currentCampaigns.find(
                            c => c.campaignCode.toString() === selectedCode
                        );
                        if (selected) updateCampaignSummary(selected);
                    }
                });
            } catch (error) {
                alert(error.message);
            }
        }

        function updateCampaignSummary(campaign) {
            if (!campaign) return;

            const amount = cartTotal;
            const months = Number(campaign.contractLengthInMonths) || 1;
            const monthlyPayment = amount * Number(campaign.monthlyAnnuityFactor || 0);

            const initialFee = Number(campaign.initialFee || 0);
            const notificationFee = Number(campaign.notificationFee || 0);
            const interestRate = Number(campaign.interestRatePercent || 0);
            const effectiveInterest = Number(campaign.effectiveInterest || 0);

            const monthlyWithFee = Math.round(monthlyPayment + notificationFee);
            const month1Payment = Math.round(monthlyPayment + notificationFee + initialFee);

            const totalCost = initialFee + (monthlyWithFee) * months;

            document.getElementById("summaryInitialFee").textContent = formatCurrency(initialFee);
            document.getElementById("summaryNotificationFee").textContent = formatCurrency(notificationFee);
            document.getElementById("summaryInterestRate").textContent = interestRate + " %";
            document.getElementById("summaryEffectiveInterest").textContent = (effectiveInterest ? formatDecimal(effectiveInterest) : "0.00") + " %";
            document.getElementById("summaryTotalCost").innerHTML = "<strong>" + formatCurrency(totalCost) + "</strong>";

            document.getElementById("summaryMonth1").textContent = formatCurrency(month1Payment);

            const restRow = document.getElementById("summaryRestRow");
            if (months > 1) {
                document.getElementById("summaryMonthTo").textContent = months;
                document.getElementById("summaryMonthRest").textContent = formatCurrency(monthlyWithFee);
                restRow.style.display = "";
            } else {
                // Hide the Månad 2-N row if only 1 month
                restRow.style.display = "none";
            }

            const avgPerMonth = totalCost / months;
            document.getElementById("summaryAvgPerMonth").textContent = formatCurrency(avgPerMonth);

            document.getElementById("campaignSummary").style.display = "block";
            document.getElementById("modalMonth1").textContent = formatCurrency(month1Payment);
            document.getElementById("modalMonth2").textContent = formatCurrency(monthlyWithFee);
            document.getElementById("modalMonthRangeLabel").textContent = "Månad 3–" + months;
            document.getElementById("modalMonthRest").textContent = formatCurrency(monthlyWithFee);
        }

        function formatDecimal(value) {
            return value ? parseFloat(value).toFixed(2) : "N/A";
        }

        function formatCurrency(n) {
            const v = Number.isFinite(n) ? Math.round(n) : 0;
            return v.toLocaleString('sv-SE') + " kr";
        }

        // Toggle test customers visibility
        const toggleButton = document.getElementById("toggleTestCustomers");
        const testCustomersDiv = document.getElementById("testCustomers");
        const visibilityForm = document.getElementById("toggleVisibilityForm");
        const visibilityInput = document.getElementById("isTestCustomersVisible");
        let isVisible = @((TempData["IsTestCustomersVisible"] ?? "true").ToString().ToLower());

        toggleButton.addEventListener("click", () => {
            isVisible = !isVisible;

            if (isVisible) {
                testCustomersDiv.style.display = "block";
                toggleButton.textContent = ">";
            } else {
                testCustomersDiv.style.display = "none";
                toggleButton.textContent = "<";
            }

            visibilityInput.value = isVisible;
            visibilityForm.submit();
        });

        // Toggle Webpay config visibility
        document.getElementById("toggleWebpayConfig").addEventListener("click", function () {
            var configDiv = document.getElementById("webpayConfig");
            if (configDiv.style.display === "none" || configDiv.style.display === "") {
                configDiv.style.display = "block";
            } else {
                configDiv.style.display = "none";
            }
        });

        // For placeholders
        document.getElementById("isCompany").addEventListener("change", function () {
            var ssnInput = document.getElementById("ssn");
            var privatePlaceholder = ssnInput.getAttribute("data-private-placeholder");
            var companyPlaceholder = ssnInput.getAttribute("data-company-placeholder");

            if (this.checked) {
                ssnInput.setAttribute("placeholder", companyPlaceholder);
            } else {
                ssnInput.setAttribute("placeholder", privatePlaceholder);
            }
        });

        function acceptPlaceholderOnEnter(inputElem) {
            inputElem.addEventListener("keydown", function(e) {
                //if (e.key === "Enter") {
                if (e.key === "Tab") {
                    if (!this.value.trim()) {
                        this.value = this.getAttribute("placeholder");
                    }
                    //e.preventDefault();
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            var ssnInput = document.getElementById("ssn");
            var emailInput = document.getElementById("emailAddress");
            var phoneInput = document.getElementById("phoneNumber");
            // Attach listeners
            acceptPlaceholderOnEnter(ssnInput);
            acceptPlaceholderOnEnter(emailInput);
            acceptPlaceholderOnEnter(phoneInput);
        });

    </script>
}
